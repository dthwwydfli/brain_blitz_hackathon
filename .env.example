# ── Backend (copy to backend/.env) ───────────────────────────────
# LLM — Gemini 2.0 Flash via GCP credits (aistudio.google.com)
GEMINI_API_KEY=

# Live web research grounding (linkup.so — free tier)
LINKUP_API_KEY=

# Shared memory / session state (Upstash Redis — free tier)
# REST URL + token from the Upstash console
REDIS_URL=rediss://your-upstash-url
REDIS_TOKEN=

# Only if using CopilotKit Cloud (optional for local)
COPILOTKIT_API_KEY=

# ── Frontend (copy to frontend/.env.local) ───────────────────────
# Backend FastAPI base URL. Local: http://localhost:8000
# Prod: the Railway/Render URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pre-seeded demo session (matches scripts/seed_demo.py). Optional.
NEXT_PUBLIC_DEMO_SESSION_ID=demo_session_citypulse
